$TTL    604800
@       IN      SOA     server.company.local. admin.company.local. (
                          3         ; Serial
                     604800         ; Refresh
                      86400         ; Retry
                    2419200         ; Expire
                     604800 )       ; Negative Cache TTL
;
@       IN      NS      server.company.local.

; Сопоставление доменных имен с IP:
server  IN      A       192.168.10.10
router  IN      A       192.168.10.1
app     IN      A       192.168.10.10
grafana IN      A       192.168.10.10
